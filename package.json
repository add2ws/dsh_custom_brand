{
  "name": "@local/dsh-plugin-brand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "自定义 DSH 的品牌标识（logo）与品牌标语（slogan）：覆盖侧边栏品牌区与会话空状态页标题。",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
